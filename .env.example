# Development / demonstration only. Demo usernames and passwords are enabled in this mode.
VITE_AUTH_MODE=mock
VITE_DATA_MODE=mock
VITE_API_BASE_URL=/api
VITE_AI_IMAGE_MODE=demo
# Optional real image service: set mode=api and configure a multipart POST endpoint.
# VITE_AI_IMAGE_ENDPOINT=/api/ai/analyze-image
# mock: JSON seed + localStorage, no network persistence.
# json-server: bundled demo backend at /api/data (npm run dev).
# api: real backend snapshot contract at /dataset, /dataset/reset, /eel-public-data.

# Production: configure VITE_AUTH_MODE=api and point to an HTTPS authentication service.
# VITE_AUTH_MODE=api
# VITE_API_BASE_URL=https://api.example.com
